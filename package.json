{
  "name": "beachball-portal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "next dev",
    "dev:poll": "cross-env WATCHPACK_POLLING=true next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "cross-env TZ=UTC vitest run && cross-env TZ=Asia/Tokyo vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:roles": "tsx src/db/scripts/roles.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio --host 0.0.0.0",
    "db:seed": "tsx src/db/scripts/seed.ts",
    "dev:grant-admin": "tsx src/db/scripts/grant-admin.ts",
    "job:mail": "tsx src/jobs/mail.ts",
    "mail:test": "tsx src/jobs/mail-test.ts",
    "db:reset": "tsx src/db/scripts/reset.ts && pnpm db:roles && pnpm db:migrate && pnpm db:seed"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.5",
    "nodemailer": "^10.0.10",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}

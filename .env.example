# ローカル用の環境変数（設計書 §6.3）。コンテナを作ったときに .env へコピーされる（.devcontainer/post-create.sh）
# 本番の値は Secret Manager に置く。このファイルに本物の秘密を書かない

# ---- DB。コンテナの中からは db:5432。ロールは `pnpm db:roles` が作る（パスワードは下の URL から読む）
POSTGRES_ADMIN_URL=postgres://postgres:postgres@db:5432/beach
# アプリ（app_user）。Cloud Run のアプリにはこれだけを渡す
DATABASE_URL=postgres://app_user:app_user@db:5432/beach
# マイグレーション（app_owner = テーブルの所有者）
MIGRATION_DATABASE_URL=postgres://app_owner:app_owner@db:5432/beach
# 日次ジョブ（app_job）・バックアップ（app_backup = 読み取りだけ）
JOB_DATABASE_URL=postgres://app_job:app_job@db:5432/beach
BACKUP_DATABASE_URL=postgres://app_backup:app_backup@db:5432/beach
# アプリの接続プールの上限（省略時 5。本番は Cloud Run のインスタンス数 × この値が Neon の上限を超えないようにする）
# DB_POOL_MAX=5

# ---- サイト
APP_BASE_URL=http://localhost:3000
# 利用規約・プライバシーポリシーの版（アカウント作成時に保存する）
TERMS_VERSION=2027-01-31

# ---- 認証。ローカル用の仮の値（本番は別に作り、片方ずつ入れ替えられる）
SESSION_SECRET=local-session-secret-not-for-production
LOGIN_CODE_HMAC_KEY=local-login-code-hmac-key-not-for-production
LOGIN_CODE_TTL_MINUTES=10
LOGIN_CODE_MAX_ATTEMPTS=5
SESSION_TTL_DAYS=10
SESSION_SLIDING=true

# ---- メール。ローカルは Mailpit に届く（受信箱は http://localhost:8025）。本物のアドレスには送られない
# MAIL_PROVIDER: smtp（= mailpit。SMTP_URL へ送る）/ console（標準出力に出すだけ）/ brevo（本番。X-01）
MAIL_PROVIDER=smtp
SMTP_URL=smtp://mailpit:1025
MAIL_FROM=noreply@localhost
# サイトの運営者宛ての問い合わせの転送先（協会の連絡先が未設定のときの予備にも使う）
CONTACT_TO=contact@localhost
# 本番（Brevo）だけ
MAIL_API_KEY=
BREVO_WEBHOOK_TOKEN=

# ---- 運営管理者の初期登録（seed スクリプトだけが読む。2 名以内。カンマ区切り）
SUPER_ADMIN_EMAILS=

# ---- ファイル。ローカルは .local-storage/ に保存する。R2 は本番だけ
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
PUBLIC_FILES_BASE_URL=

# ---- バックアップの暗号化（本番だけ）
BACKUP_ENCRYPTION_KEY=

# ---- P1（パスキー・認証アプリ）。P0 のコードは読まない
# WEBAUTHN_RP_ID=
# WEBAUTHN_ORIGIN=
# MFA_ENCRYPTION_KEY=
